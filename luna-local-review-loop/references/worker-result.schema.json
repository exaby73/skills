{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structured final result contract for one native or project-local Luna worker session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "changedFiles", "validators", "unresolved", "parentAction"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["completed", "blocked", "needs_parent_action"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parentAction": { "type": ["string", "null"] }
  }
}
